{
  "expo": {
    "name": "Voyagami",
    "slug": "voyagami",
    "scheme": "voyagami",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.voyagami.dev"
    },
    "android": {
      "package": "app.voyagami.dev"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-contacts",
        { "contactsPermission": "Voyagami uses your contacts to find friends to invite to a trip." }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
