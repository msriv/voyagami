{
  "expo": {
    "name": "Voyagami",
    "slug": "voyagami",
    "scheme": "voyagami",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.voyagami.dev"
    },
    "android": {
      "package": "app.voyagami.dev"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Voyagami uses your contacts to find friends to invite to a trip."
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Voyagami shares where you are with your crew only while you choose to."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cc1bb2fe-4416-462d-9108-b25da6f9d835"
    },
    "extra": {
      "eas": {
        "projectId": "cc1bb2fe-4416-462d-9108-b25da6f9d835"
      }
    }
  }
}
