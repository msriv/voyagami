      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "main",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://voyagami-api-405147124521.asia-south1.run.app"
      }
    }
  }
}
